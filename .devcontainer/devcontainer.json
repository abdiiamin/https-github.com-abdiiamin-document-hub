{
    "name": "DocumentHub PHP",
    "image": "mcr.microsoft.com/devcontainers/php:8.1",
    "features": {
        "ghcr.io/devcontainers/features/mysql-homebrew:1": {},
        "ghcr.io/devcontainers/features/node:1": {}
    },
    "forwardPorts": [8000, 3306],
    "postCreateCommand": "composer install && php -S 0.0.0.0:8000 -t public/",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "xdebug.php-debug",
                "ikappas.phpcs",
                "cweijan.vscode-mysql-client2"
            ]
        }
    }
}
